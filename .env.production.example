# ==========================================
# KIOSKOS & DESPENZAS — Variables de Producción
# ==========================================
# ⚠️  RENOMBRAR este archivo a .env antes de usar en el VPS
# ⚠️  NUNCA subir el .env real al repositorio
# ==========================================

# ==========================================
# DOMINIO (sin https://)
# ==========================================
DOMAIN=tudominio.com
GITHUB_OWNER=tu_usuario_github

# ==========================================
# BASE DE DATOS
# ==========================================
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=kioskos_user
DB_PASSWORD=contraseña_segura_aqui
DB_ROOT_PASSWORD=contraseña_root_segura
DB_DATABASE=kioskos_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ==========================================
# JWT — Generar con: openssl rand -base64 64
# ==========================================
JWT_SECRET=reemplazar_con_clave_aleatoria_larga_y_segura
JWT_EXPIRES_IN=8h

# ==========================================
# REDIS
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# FRONTEND (URL pública de la API)
# ==========================================
VITE_API_URL=https://tudominio.com

# ==========================================
# CORREO (SMTP) — Opcional
# ==========================================
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=tu_usuario_smtp
MAIL_PASS=tu_password_smtp
MAIL_FROM=noreply@tudominio.com

# ==========================================
# MERCADOPAGO (https://www.mercadopago.com.ar/developers)
# ==========================================
# PRODUCCIÓN (comienza con APP_USR-):
MP_ACCESS_TOKEN=APP_USR-tu_access_token_de_produccion
MP_PUBLIC_KEY=APP_USR-tu_public_key

# SANDBOX/TESTING (comienza con TEST-) — para pruebas en localhost:
# MP_ACCESS_TOKEN=TEST-tu_access_token_de_prueba
# MP_PUBLIC_KEY=TEST-tu_public_key_de_prueba
#
# ▸ Cómo obtener credenciales de testing:
#   1. Ir a https://www.mercadopago.com.ar/developers/panel/app
#   2. Crear una aplicación
#   3. En "Credenciales" → elegir "Credenciales de prueba"
#   4. Crear usuarios de prueba desde la API:
#      curl -X POST https://api.mercadopago.com/users/test \
#        -H "Authorization: Bearer TEST-tu-token" \
#        -d '{"site_id":"MLA"}'
#   5. Tarjetas de prueba disponibles en el checkout (modo sandbox)
#
# URL pública del backend (donde MP enviará webhooks)
# En producción: la URL pública del VPS
# En sandbox: usar ngrok o similar para exponer localhost
APP_URL=https://api.tudominio.com
# URL del frontend
FRONTEND_URL=https://tudominio.com

# ==========================================
# TRANSFERENCIAS BANCARIAS (CBU/Alias)
# ==========================================
# Datos de tu cuenta para recibir transferencias manuales
TRANSFER_ALIAS=tu.alias.aqui
TRANSFER_CBU=0000000000000000000000

# ==========================================
# STORAGE AWS S3 — Opcional para logos
# ==========================================
S3_ACCESS_KEY=tu_access_key
S3_SECRET_KEY=tu_secret_key
S3_BUCKET=kioskos-assets
S3_REGION=us-east-1

