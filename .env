# ==========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==========================================
NODE_ENV=development
APP_PORT=3000
APP_NAME="Kioskos_API"
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ==========================================
# BASE DE DATOS
# ==========================================
DB_TYPE=mysql
DB_HOST=localhost       # Cambiar a 'db' si usas Docker
DB_PORT=3306
DB_USERNAME=dev_user
DB_PASSWORD=dev_password
DB_DATABASE=kioskos_db
DB_SYNCHRONIZE=false     # WARN: false en producción
DB_LOGGING=true

# ==========================================
# SEGURIDAD Y AUTENTICACIÓN
# ==========================================
JWT_SECRET=clavesecreta_2026_para_desarrollo_local_cambiar_en_prod
JWT_EXPIRES_IN=8h

# ==========================================
# REDIS
# ==========================================
REDIS_HOST=localhost    # Cambiar a 'redis' si usas Docker
REDIS_PORT=6379

# ==========================================
# CORREO (SMTP)
# ==========================================
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=tu_usuario_mailtrap
MAIL_PASS=tu_password_mailtrap
MAIL_FROM="noreply@supermarket.com"

# ==========================================
# STORAGE AWS S3 (Opcional)
# ==========================================
S3_ACCESS_KEY=tus_credenciales_s3
S3_SECRET_KEY=tus_credenciales_s3
S3_BUCKET=kioskos-assets
S3_REGION=us-east-1

# ==========================================
# FRONTEND (Vite)
# ==========================================
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000


# ==========================================
# FACTURACIÓN ELECTRÓNICA AFIP
# ==========================================
# Secreto para cifrado AES-256 de certificados y claves AFIP.
# ⚠️ CAMBIAR EN PRODUCCIÓN — mínimo 32 caracteres aleatorios
AFIP_ENCRYPTION_SECRET=dev_afip_encription_secret_cambiar_en_produccion_2026

### PAGOS
MP_ACCESS_TOKEN=APP_USR-...    # MercadoPago Access Token
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3000
TRANSFER_ALIAS=tu.alias
TRANSFER_CBU=0000000...

# ==========================================
# CONFIGURACIÓN OAUTH MERCADOPAGO (PLATAFORMA)
# ==========================================
# Client ID y Secret de tu Aplicación en MercadoPago Developers
MP_CLIENT_ID=4644969659897356
MP_CLIENT_SECRET=6yaYLdtsDnYtVdpQi1U5jV3sN1Vo7DXC
MP_REDIRECT_URI=https://api.kioskos.dariassoft.com.ar/api/v1/settings/mercadopago/callback
APP_URL_FRONTEND=http://localhost:5173
